  untshpfax    String?
  untshpeml    String?
  untshpweb    String?

  unttinno String?
  unttindt DateTime?
  unttanno String?
  unttandt DateTime?
  untlstno String?
  untlstdt DateTime?
  untcstno String?
  untcstdt DateTime?
  untpanno String?
  untpandt DateTime?
  untstno  String?
  untstdt  DateTime?
  untexno  String?
  untexdt  DateTime?

  untdispnm String?

  avgsale Decimal?
