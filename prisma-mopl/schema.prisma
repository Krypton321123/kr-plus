  untcomweb    String?

  untchkbil    Boolean?
  untbiladr1   String?
  untbiladr2   String?
  untbilctycd  String?
  cuntbilzipcd String?
  untbilphn    String?
  untbilfax    String?
  untbileml    String?
  untbilweb    String?

  untchkshpbil Boolean?
  untchkshpcom Boolean?
  untshpadr1   String?
  untshpadr2   String?
  untshpctycd  String?
  cuntshpzipcd String?
