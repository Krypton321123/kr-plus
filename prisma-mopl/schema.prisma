  mmluntcd String?

  userUnit userUnit[]
}

model User {
  rowid Int @id @default(autoincrement())

  usrcd          String?
  usrnm          String
  usrshnm        String
  bseuntcd       String
  usrcat         String
  userCat        userCategory @relation(fields: [usrcat], references: [catcd])
  pass           String
  validdt        DateTime
  dlock          String
  msgenable      String
  untall         String
  usertyp        String
  userdep        String
  sts            String
  entusrnm       String
  entdt          DateTime
  allowedScreens userScreen[]
  allowedUnits   userUnit[]
}

model userCategory {
  rowid Int @id @default(autoincrement())

  catcd    String?  @unique
  catnm    String
  sts      String
  entusrnm String
  entdt    DateTime

  User User[]
}

model userScreen {
  rowid Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [rowid])

  screen Int
  menu   mstMenuConfig @relation(fields: [screen], references: [rowid])

  viewOnly Boolean @default(false)
}

model userUnit {
  rowid Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [rowid])

  unit Int
  Unit Unit @relation(fields: [unit], references: [rowid])
}

model mstMenuConfig {
